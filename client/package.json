{
  "name": "todo-grpc-client",
  "version": "1.0.0",
  "description": "Node.js gRPC client + Express UI for the todo app",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i src/input.css -o public/output.css",
    "watch:css": "tailwindcss -i src/input.css -o public/output.css --watch"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.14"
  }
}
